#version 430

// MSR 2.0 Compute Temporal Pass - variance clipping in YCoCg.
// GL 4.3+ path. The fragment implementation in msr_temporal.fsh is the fallback.
//
// History layouts (must match MSRHistoryTarget):
//   colour : R11G11B10F (32 bit, no alpha)
//   depth  : R16UI      (packed current depth, 16 bit)
//
// The pass reads the current low-resolution frame plus the ping-pong history and writes the
// accumulated result into the *other* history target.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D CurrentColor;   // current frame, source resolution
uniform sampler2D CurrentDepth;   // current depth buffer, source resolution
uniform sampler2D HistoryColor;   // previous frame history colour
uniform usampler2D HistoryDepth;  // previous frame packed depth (R16UI)

uniform vec2 InputSize;
uniform vec2 OutputSize;
uniform vec2 Jitter;
uniform float VarianceScale;
uniform float DepthThreshold;
uniform float HistoryWeight;
uniform vec3 CameraDelta;
uniform mat4 ViewRotation;
uniform mat4 PrevViewRotation;
uniform mat4 InvProjection;
uniform mat4 PrevProjection;
uniform float HistoryValid;
uniform float DepthValid;

// Image load/store outputs.
layout(r11f_g11f_b10f, binding = 0) writeonly uniform image2D HistoryColorOut;
layout(r16ui,           binding = 1) writeonly uniform uimage2D HistoryDepthOut;

vec3 rgbToYCoCg(vec3 rgb) {
    return vec3(
        rgb.r * 0.25 + rgb.g * 0.5 + rgb.b * 0.25,
        rgb.r * 0.5 - rgb.b * 0.5,
        rgb.g * 0.5 - rgb.r * 0.25 - rgb.b * 0.25
    );
}

vec3 yCoCgToRgb(vec3 ycocg) {
    float t = ycocg.x - ycocg.z;
    return vec3(t + ycocg.y, ycocg.x + ycocg.z, t - ycocg.y);
}

float unpackDepth(uint depthBits) {
    return float(depthBits) / 65535.0;
}

uint packDepth(float depth) {
    return uint(clamp(depth * 65535.0, 0.0, 65535.0));
}

// 3x3 neighbourhood mean/variance in YCoCg space (FSR 2 style variance clipping).
//
// This MUST sample the current frame. The previous version sampled HistoryColor, so the
// acceptance window described the history itself: stale values always fell inside it and the
// clipping never rejected anything, which is exactly what made moving-camera MSR ghost.
void computeVariance(vec2 uv, vec2 texel,
                     out vec3 meanYCoCg, out vec3 varianceYCoCg) {
    meanYCoCg = vec3(0.0);
    vec3 meanSq = vec3(0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 sampleUv = clamp(uv + vec2(float(x), float(y)) * texel, vec2(0.0), vec2(1.0));
            vec3 color = texture(CurrentColor, sampleUv).rgb;
            vec3 ycocg = rgbToYCoCg(color);
            meanYCoCg += ycocg;
            meanSq += ycocg * ycocg;
        }
    }

    meanYCoCg /= 9.0;
    meanSq /= 9.0;
    varianceYCoCg = max(vec3(0.0), meanSq - meanYCoCg * meanYCoCg);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(InputSize);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(InputSize);

    // MSR does not jitter the projection matrix, but keep the uniform so a future jittered
    // path does not need shader changes.
    vec2 currentUv = clamp(uv + Jitter * 0.5, vec2(0.0), vec2(1.0));

    vec3 currentColor = texture(CurrentColor, currentUv).rgb;
    float currentDepth = texture(CurrentDepth, currentUv).r;

    bool valid = HistoryValid > 0.5;
    bool depthValid = DepthValid > 0.5;

    vec2 historyUv = uv;
    vec3 historyColor = vec3(0.0);
    float historyDepth = 0.0;

    // --- Reproject the current pixel into the previous frame (camera-only motion) ---
    if (valid && depthValid) {
        vec2 ndc = currentUv * 2.0 - 1.0;
        vec4 clip = vec4(ndc, currentDepth * 2.0 - 1.0, 1.0);
        vec4 viewPosition = InvProjection * clip;

        if (abs(viewPosition.w) > 1.0e-6) {
            viewPosition /= viewPosition.w;

            // View space -> world space relative to the current camera orientation.
            // vec4 * mat4 is the transpose multiplication, i.e. the inverse rotation.
            vec3 worldRelative = (vec4(viewPosition.xyz, 0.0) * ViewRotation).xyz;

            bool isSky = currentDepth > 0.9999995;
            vec3 previousRelative = worldRelative + (isSky ? vec3(0.0) : CameraDelta);

            vec3 previousView = (PrevViewRotation * vec4(previousRelative, 1.0)).xyz;
            vec4 previousClip = PrevProjection * vec4(previousView, 1.0);

            if (previousClip.w > 1.0e-6) {
                vec2 previousNdc = previousClip.xy / previousClip.w;
                historyUv = previousNdc * 0.5 + 0.5;
                valid = valid
                        && all(greaterThanEqual(historyUv, vec2(0.0)))
                        && all(lessThanEqual(historyUv, vec2(1.0)));
            } else {
                valid = false;
            }
        } else {
            valid = false;
        }
    } else {
        valid = false;
    }

    if (valid) {
        historyColor = texture(HistoryColor, historyUv).rgb;
        historyDepth = unpackDepth(texture(HistoryDepth, historyUv).r);

        // Disocclusion: a large depth change means the history belongs to another surface.
        float tolerance = max(DepthThreshold * currentDepth * currentDepth, 0.02);
        valid = abs(historyDepth - currentDepth) <= tolerance;
    }

    vec2 texel = 1.0 / InputSize;
    vec3 meanYCoCg;
    vec3 varianceYCoCg;
    computeVariance(currentUv, texel, meanYCoCg, varianceYCoCg);

    vec3 currentYCoCg = rgbToYCoCg(currentColor);
    vec3 historyYCoCg = rgbToYCoCg(historyColor);

    vec3 stdDev = sqrt(max(vec3(0.0), varianceYCoCg));
    vec3 lowerBound = meanYCoCg - VarianceScale * stdDev;
    vec3 upperBound = meanYCoCg + VarianceScale * stdDev;

    // Clamp rather than reject: a slightly out-of-range history fades out smoothly instead of
    // flickering between "full history" and "no history" on every frame.
    historyYCoCg = clamp(historyYCoCg, lowerBound, upperBound);

    float historyBlend = HistoryWeight;
    if (!valid || !depthValid) {
        historyBlend = 0.0;
    }

    vec3 outputColor = yCoCgToRgb(mix(currentYCoCg, historyYCoCg, historyBlend));

    imageStore(HistoryColorOut, pixel, vec4(outputColor, currentDepth));
    imageStore(HistoryDepthOut, pixel, uvec4(packDepth(currentDepth), 0u, 0u, 0u));
}
