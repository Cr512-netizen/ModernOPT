#version 430

// MSR 2.0 compute temporal pass: variance clipping in YCoCg.
// GL 4.3+ path; GPUs without compute use the spatial MSR2 fallback instead.
//
// History layouts (must match MSR2HistoryTarget):
//   colour : RGBA16F (64 bit; alpha unused)
//   depth  : R16UI   (packed current depth, 16 bit)
//
// The pass reads the current low-resolution frame plus the ping-pong history and writes the
// accumulated result into the *other* history target. OutputSize is the output-resolution history
// (RGBA16F + R16UI); InputSize is the low-resolution world colour/depth.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Explicit locations are required for non-opaque uniforms when the compute program is compiled to
// SPIR-V for spirv-val; they also make the uniform layout independent of driver assignment.
layout(binding = 4) uniform sampler2D CurrentColor;   // current frame, source resolution
layout(binding = 5) uniform sampler2D CurrentDepth;   // current depth buffer, source resolution
layout(binding = 6) uniform sampler2D HistoryColor;   // previous frame history colour
layout(binding = 7) uniform usampler2D HistoryDepth;  // previous frame packed depth (R16UI)

layout(location = 0) uniform vec2 InputSize;
layout(location = 1) uniform vec2 OutputSize;
layout(location = 2) uniform vec2 Jitter;
layout(location = 3) uniform float VarianceScale;
layout(location = 4) uniform float DepthThreshold;
layout(location = 5) uniform float HistoryWeight;
layout(location = 6) uniform vec3 CameraDelta;
layout(location = 7) uniform mat4 ViewRotation;
layout(location = 8) uniform mat4 PrevViewRotation;
layout(location = 9) uniform mat4 InvProjection;
layout(location = 10) uniform mat4 PrevProjection;
layout(location = 11) uniform float HistoryValid;
layout(location = 12) uniform float DepthValid;
layout(location = 13) uniform int UseLanczos;
layout(location = 14) uniform int LanczosRadius;
layout(location = 15) uniform vec2 ColorSize;  // resolution of CurrentColor (EASU output or source)
// Polyphase Lanczos table, uploaded once as a 129x12 R32F texture (rows 0..5 = radius 2,
// rows 6..11 = radius 3). Entry p covers the fractional phase p/128; the six taps are offsets
// -2..+3. A texture avoids dynamically indexed uniform arrays, which some drivers lower onto a
// tiny local array and then fail to compile.
layout(binding = 8) uniform sampler2D LanczosTable;
// Entity motion vectors at source resolution: RG = previousUv - currentUv, B = coverage mask.
layout(binding = 9) uniform sampler2D MotionVectors;
layout(location = 16) uniform float MotionValid;

// Image load/store outputs.
layout(rgba16f, binding = 0) writeonly uniform image2D HistoryColorOut;
layout(r16ui,   binding = 1) writeonly uniform uimage2D HistoryDepthOut;

vec3 rgbToYCoCg(vec3 rgb) {    return vec3(
        rgb.r * 0.25 + rgb.g * 0.5 + rgb.b * 0.25,
        rgb.r * 0.5 - rgb.b * 0.5,
        rgb.g * 0.5 - rgb.r * 0.25 - rgb.b * 0.25
    );
}

vec3 yCoCgToRgb(vec3 ycocg) {
    float t = ycocg.x - ycocg.z;
    return vec3(t + ycocg.y, ycocg.x + ycocg.z, t - ycocg.y);
}

float unpackDepth(uint depthBits) {
    return float(depthBits) / 65535.0;
}

uint packDepth(float depth) {
    return uint(clamp(depth * 65535.0, 0.0, 65535.0));
}

ivec2 clampPixel(ivec2 pixel, ivec2 size) {
    return clamp(pixel, ivec2(0), size - ivec2(1));
}

// Entity motion vectors are rasterised from projected boxes at source resolution, so the box can
// miss the outermost silhouette sample by one texel. If the centre sample has no coverage, look
// at the 3x3 neighbourhood and accept the closest covered vector only when its depth matches the
// current surface. Without the depth test a background pixel next to a mob would inherit the
// mob's vector and drag the background towards it.
vec2 sampleEntityMotion(vec2 uv, float centerDepth, out bool covered) {
    ivec2 sourceSize = ivec2(InputSize);
    ivec2 base = clamp(ivec2(uv * InputSize), ivec2(0), sourceSize - ivec2(1));
    vec4 center = texelFetch(MotionVectors, base, 0);
    if (center.z > 0.5) {
        covered = true;
        return center.xy;
    }

    covered = false;
    float tolerance = max(DepthThreshold * max(centerDepth * centerDepth, 0.01), 0.01);
    float bestScore = 1.0e20;
    vec2 best = vec2(0.0);
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            if (x == 0 && y == 0) {
                continue;
            }
            ivec2 p = clamp(base + ivec2(x, y), ivec2(0), sourceSize - ivec2(1));
            vec4 motionSample = texelFetch(MotionVectors, p, 0);
            if (motionSample.z <= 0.5) {
                continue;
            }
            float depth = texelFetch(CurrentDepth, p, 0).r;
            float depthError = abs(depth - centerDepth);
            if (DepthValid > 0.5 && depthError > tolerance * 1.5) {
                continue;
            }
            // The depth difference dominates; among equally close surfaces prefer the longer
            // vector, which is the one that actually covers a fast silhouette.
            float score = depthError - length(motionSample.xy) * tolerance * 0.05;
            if (score < bestScore) {
                bestScore = score;
                best = motionSample.xy;
                covered = true;
            }
        }
    }
    return best;
}

// Bilateral history reconstruction. The history colour is filtered linearly, but the history
// depth is nearest-neighbour, so a plain colour fetch at a silhouette mixes foreground and
// background even though the depth test only saw one of them. Fetch the four texels of the
// bilinear footprint, weight each by its depth agreement with the current surface, and drop the
// taps that belong to another surface. On a stable pixel all four taps have the same depth, so
// this is exactly the old bilinear fetch and costs no sharpness.
void sampleHistoryBilateral(vec2 uv, float currentDepth, float tolerance,
                            out vec3 color, out float depth, out bool ok) {
    ivec2 size = ivec2(OutputSize);
    vec2 position = uv * OutputSize - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 fraction = clamp(position - vec2(base), vec2(0.0), vec2(1.0));
    ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));
    float weights[4] = float[4](
            (1.0 - fraction.x) * (1.0 - fraction.y),
            fraction.x * (1.0 - fraction.y),
            (1.0 - fraction.x) * fraction.y,
            fraction.x * fraction.y);

    color = vec3(0.0);
    depth = 0.0;
    float weightSum = 0.0;
    for (int i = 0; i < 4; i++) {
        if (weights[i] <= 1.0e-5) {
            continue;
        }
        ivec2 p = clampPixel(base + offsets[i], size);
        float tapDepth = unpackDepth(texelFetch(HistoryDepth, p, 0).r);
        float depthError = abs(tapDepth - currentDepth);
        float weight = weights[i] * (1.0 - smoothstep(tolerance * 0.5, tolerance, depthError));
        if (weight <= 1.0e-5) {
            continue;
        }
        color += texelFetch(HistoryColor, p, 0).rgb * weight;
        depth += tapDepth * weight;
        weightSum += weight;
    }

    if (weightSum <= 1.0e-4) {
        // Every history tap belongs to a different surface. This is a real disocclusion: the
        // caller must fall back to the current frame instead of blending the old surface in.
        ok = false;
        color = vec3(0.0);
        depth = 0.0;
        return;
    }
    color /= weightSum;
    depth /= weightSum;
    ok = true;
}

// Lanczos reconstruction of the low-resolution current frame. The temporal history already lives
// at output resolution, so this is the only place where a sharper spatial kernel can still
// recover edge contrast from the reduced input. Luma is reconstructed with the signed Lanczos
// kernel. Chroma uses a plain bilinear fetch: chroma detail is low-frequency, and a signed
// kernel on colour-difference channels is what produces coloured halos on high-contrast edges.
const int LANCZOS_TAPS = 6;

vec3 sampleCurrentLanczos(vec2 uv, float centerDepth) {
    vec2 source = uv * InputSize - 0.5;
    vec2 base = floor(source);
    vec2 fraction = clamp(source - base, vec2(0.0), vec2(1.0));
    int phaseX = int(fraction.x * 128.0 + 0.5);
    int phaseY = int(fraction.y * 128.0 + 0.5);
    bool radius3 = LanczosRadius >= 3;
    int layer = radius3 ? 1 : 0;
    ivec2 sourceSize = ivec2(InputSize);
    ivec2 basePixel = ivec2(base);
    float lumaSum = 0.0;
    float lumaWeight = 0.0;
    float lumaMin = 1.0e20;
    float lumaMax = -1.0e20;

    // Depth guidance is only needed near a silhouette. Checking the four nearest depth texels
    // once costs five fetches; fetching depth for all 36 colour taps would cost seven times more
    // on every pixel, including the large flat areas where the weights are identical to 1.0.
    float depthTolerance = max(0.0025, centerDepth * 0.02);
    bool useDepth = DepthValid > 0.5;
    if (useDepth) {
        ivec2 p = basePixel;
        float d0 = texelFetch(CurrentDepth, clampPixel(p + ivec2(-1, 0), sourceSize), 0).r;
        float d1 = texelFetch(CurrentDepth, clampPixel(p + ivec2(1, 0), sourceSize), 0).r;
        float d2 = texelFetch(CurrentDepth, clampPixel(p + ivec2(0, -1), sourceSize), 0).r;
        float d3 = texelFetch(CurrentDepth, clampPixel(p + ivec2(0, 1), sourceSize), 0).r;
        float minDepth = min(centerDepth, min(min(d0, d1), min(d2, d3)));
        float maxDepth = max(centerDepth, max(max(d0, d1), max(d2, d3)));
        useDepth = maxDepth - minDepth > depthTolerance;
    }

    for (int y = 0; y < LANCZOS_TAPS; y++) {
        int offsetY = y - 2;
        float wy = texelFetch(LanczosTable, ivec2(phaseY, y + layer * 6), 0).r;
        if (abs(wy) < 1.0e-6) {
            continue;
        }
        for (int x = 0; x < LANCZOS_TAPS; x++) {
            int offsetX = x - 2;
            float wx = texelFetch(LanczosTable, ivec2(phaseX, x + layer * 6), 0).r;
            float weight = wx * wy;
            if (abs(weight) < 1.0e-6) {
                continue;
            }
            ivec2 pixel = clampPixel(basePixel + ivec2(offsetX, offsetY), sourceSize);
            vec3 color = texelFetch(CurrentColor, pixel, 0).rgb;

            if (useDepth) {
                float tapDepth = texelFetch(CurrentDepth, pixel, 0).r;
                float depthWeight = 1.0 - smoothstep(depthTolerance, depthTolerance * 2.0,
                        abs(tapDepth - centerDepth));
                if (depthWeight <= 0.05) {
                    continue;
                }
                // Squaring makes the weight fall off faster on silhouette edges, where a
                // neighbour on the far surface would otherwise bleed into the reconstruction.
                weight *= depthWeight * depthWeight;
            }

            float luma = dot(color, vec3(0.25, 0.5, 0.25));
            lumaSum += luma * weight;
            lumaWeight += weight;
            lumaMin = min(lumaMin, luma);
            lumaMax = max(lumaMax, luma);
        }
    }

    vec3 center = texelFetch(CurrentColor, clampPixel(basePixel, sourceSize), 0).rgb;
    if (lumaWeight <= 1.0e-5) {
        return center;
    }

    // Anti-ringing: the signed kernel may overshoot the local luma range. A small overshoot is
    // real edge contrast, but large halos are not, so the excess is limited to a fixed budget
    // instead of being either fully preserved or fully flattened.
    float luma = lumaSum / lumaWeight;
    float lumaClamped = clamp(luma, lumaMin, lumaMax);
    float lumaContrast = max(lumaMax - lumaMin, 1.0e-4);
    float budget = min(0.010, max(0.0015, lumaContrast * 0.04));
    luma = lumaClamped + clamp(luma - lumaClamped, -budget, budget);

    vec2 chroma = rgbToYCoCg(texture(CurrentColor, uv).rgb).yz;
    return max(yCoCgToRgb(vec3(luma, chroma)), vec3(0.0));
}

// 3x3 texelFetch neighbourhood mean/variance in YCoCg space (FSR 2 style variance clipping).
// This is the path when Lanczos reconstruction is off; it uses exact source texels instead of a
// bilinear average, which used to make the acceptance box narrower than the actual frame.
void computeVariance(vec2 uv, ivec2 colorSize,
                     out vec3 meanYCoCg, out vec3 varianceYCoCg) {
    ivec2 center = ivec2(floor(uv * ColorSize));
    meanYCoCg = vec3(0.0);
    vec3 meanSq = vec3(0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 color = texelFetch(CurrentColor, clampPixel(center + ivec2(x, y), colorSize), 0).rgb;
            vec3 ycocg = rgbToYCoCg(color);
            meanYCoCg += ycocg;
            meanSq += ycocg * ycocg;
        }
    }

    meanYCoCg /= 9.0;
    meanSq /= 9.0;
    varianceYCoCg = max(vec3(0.0), meanSq - meanYCoCg * meanYCoCg);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(OutputSize);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(OutputSize);

    // Reproject the jittered current sample into the previous frame. Jitter is in clip space,
    // so the UV offset is half of it.
    vec2 currentUv = clamp(uv + Jitter * 0.5, vec2(0.0), vec2(1.0));

    // Depth at the unjittered output pixel is the value stored in the history and used for
    // disocclusion. The Lanczos depth guidance uses the jittered sample position, so the centre
    // of the filter and the reconstructed surface are the same point.
    float currentDepth = texture(CurrentDepth, uv).r;
    if (!(currentDepth >= 0.0 && currentDepth <= 1.0)) {
        // NaN, Inf or a driver returning garbage: treat it as the far plane rather than letting
        // it poison the reprojection and the packed history depth.
        currentDepth = 1.0;
    }
    float filterDepth = texture(CurrentDepth, currentUv).r;
    if (!(filterDepth >= 0.0 && filterDepth <= 1.0)) {
        filterDepth = currentDepth;
    }
    vec3 currentColor;
    bool lanczos = UseLanczos != 0;
    if (lanczos) {
        currentColor = sampleCurrentLanczos(currentUv, filterDepth);
    } else {
        // The EASU prepass de-jitters the current frame while reconstructing it, so its output
        // pixel is already the unjittered colour: sample at the pixel centre and build the
        // variance box around the same position.
        currentColor = texture(CurrentColor, uv).rgb;
    }

    // Never let a NaN or a negative value enter the ping-pong history: one bad frame would be
    // accumulated into every following frame.
    if (any(isnan(currentColor)) || any(isinf(currentColor))) {
        currentColor = vec3(0.0);
    }
    currentColor = max(currentColor, vec3(0.0));

    bool valid = HistoryValid > 0.5;
    bool depthValid = DepthValid > 0.5;

    vec2 historyUv = uv;
    vec3 historyColor = vec3(0.0);
    float historyDepth = 0.0;

    // Entity motion vectors are generated at source resolution. Their coverage mask is checked
    // first so the camera path stays unchanged for the rest of the scene. A one-texel dilation
    // with a depth test catches silhouette samples that the projected box just missed.
    vec2 entityVelocity = vec2(0.0);
    bool entityMotion = false;
    if (MotionValid > 0.5) {
        entityVelocity = sampleEntityMotion(uv, currentDepth, entityMotion);
    }

    // --- Reproject the current pixel into the previous frame ---
    if (valid && depthValid) {
        if (entityMotion) {
            // The entity vector already contains both its world motion and the camera motion.
            historyUv = uv + entityVelocity;
            float motionLen = length(entityVelocity);
            valid = valid
                    && motionLen < 0.15
                    && all(greaterThanEqual(historyUv, vec2(0.0)))
                    && all(lessThanEqual(historyUv, vec2(1.0)));
        } else {
            // uv is the output pixel centre in the unjittered grid. The jitter only selects which
            // sub-pixel sample produced currentColor; it must not move the reprojection point.
            vec2 ndc = uv * 2.0 - 1.0;
            vec4 clip = vec4(ndc, currentDepth * 2.0 - 1.0, 1.0);
            vec4 viewPosition = InvProjection * clip;

            if (abs(viewPosition.w) > 1.0e-6) {
                viewPosition /= viewPosition.w;

                // View space -> world space relative to the current camera orientation.
                // vec4 * mat4 is the transpose multiplication, i.e. the inverse rotation.
                vec3 worldRelative = (vec4(viewPosition.xyz, 0.0) * ViewRotation).xyz;

                bool isSky = currentDepth > 0.9999995;
                vec3 previousRelative = worldRelative + (isSky ? vec3(0.0) : CameraDelta);

                vec3 previousView = (PrevViewRotation * vec4(previousRelative, 1.0)).xyz;
                vec4 previousClip = PrevProjection * vec4(previousView, 1.0);

                if (previousClip.w > 1.0e-6) {
                    vec2 previousNdc = previousClip.xy / previousClip.w;
                    // The history target is aligned to the output grid, not to the previous frame's
                    // jitter phase: sample the reprojected pixel centre directly.
                    historyUv = previousNdc * 0.5 + 0.5;
                    float motionLen = length(historyUv - uv);
                    valid = valid
                            && motionLen < 0.15
                            && all(greaterThanEqual(historyUv, vec2(0.0)))
                            && all(lessThanEqual(historyUv, vec2(1.0)));
                } else {
                    valid = false;
                }
            } else {
                valid = false;
            }
        }
    } else {
        valid = false;
    }

    float tolerance = 0.0;
    if (valid) {
        // Disocclusion: a large depth change means the history belongs to another surface.
        // Reconstruct the history colour only from taps on the current surface; a mixed
        // foreground/background bilinear fetch is the main source of a dark or doubled fringe on
        // silhouettes.
        tolerance = max(DepthThreshold * currentDepth * currentDepth, 0.02);
        sampleHistoryBilateral(historyUv, currentDepth, tolerance,
                historyColor, historyDepth, valid);
    }

    vec3 currentYCoCg = rgbToYCoCg(currentColor);
    vec3 historyYCoCg = rgbToYCoCg(historyColor);
    ivec2 colorSize = ivec2(ColorSize);
    vec3 lowerBound;
    vec3 upperBound;

    {
        // Acceptance box: a tight 3x3 neighbourhood of the current sample, for both
        // reconstruction paths. The Lanczos taps span six source texels, so a box built from
        // their extrema grew with the upscale ratio - twelve output pixels at 50 % - and let a
        // moving entity keep its old colour for many frames, which read as a second, flying
        // copy. The wide kernel is for reconstruction only; history acceptance stays tight and
        // independent of the render scale.
        vec3 meanYCoCg;
        vec3 varianceYCoCg;
        if (lanczos) {
            computeVariance(currentUv, ivec2(InputSize), meanYCoCg, varianceYCoCg);
        } else {
            computeVariance(uv, colorSize, meanYCoCg, varianceYCoCg);
        }
        vec3 stdDev = sqrt(max(vec3(0.0), varianceYCoCg));
        lowerBound = meanYCoCg - VarianceScale * stdDev;
        upperBound = meanYCoCg + VarianceScale * stdDev;
    }

    // A slightly out-of-range history fades out smoothly instead of flickering between
    // "full history" and "no history" on every frame.
    historyYCoCg = clamp(historyYCoCg, lowerBound, upperBound);

    float historyBlend = HistoryWeight;
    if (!valid || !depthValid) {
        historyBlend = 0.0;
    } else {
        // Depth confidence: even a history sample that passes the hard disocclusion test becomes
        // less trustworthy as it approaches the threshold. Fading it smoothly avoids the
        // one-frame pop between full history and no history on a moving silhouette.
        float depthError = abs(historyDepth - currentDepth);
        float depthConfidence = 1.0 - smoothstep(tolerance * 0.5, tolerance, depthError);
        historyBlend *= mix(0.55, 1.0, depthConfidence);

        // Reactive mask for moving objects. Camera-only reprojection cannot follow a mob,
        // particle or the player's own body, so reject history where the *unclamped* previous
        // colour differs from the current sample. Luma is weighted higher than chroma because a
        // lighting change is a real mismatch while a hue shift alone is usually harmless.
        vec3 rawHistoryYCoCg = rgbToYCoCg(historyColor);
        float lumaDelta = abs(rawHistoryYCoCg.x - currentYCoCg.x);
        float chromaDelta = length(rawHistoryYCoCg.yz - currentYCoCg.yz);
        float reactive = max(smoothstep(0.045, 0.22, lumaDelta),
                0.65 * smoothstep(0.08, 0.32, chromaDelta));
        historyBlend *= 1.0 - 0.9 * reactive;

        // Fast motion gets less history even when its vector is correct: this is the FSR 2
        // "velocity-reactive" behaviour and prevents a long cross-fade trail on a sprinting mob
        // or during a fast camera pan. At rest the weight is allowed slightly above the configured
        // base, which improves convergence without introducing visible ghosting.
        float motionPixels = length((historyUv - uv) * OutputSize);
        float speed = smoothstep(2.0, 48.0, motionPixels);
        historyBlend *= mix(1.05, 0.55, speed);
        if (entityMotion) {
            historyBlend *= mix(1.0, 0.60, smoothstep(1.0, 24.0, motionPixels));
        }
        historyBlend = clamp(historyBlend, 0.0, 0.95);
    }

    vec3 outputColor = yCoCgToRgb(mix(currentYCoCg, historyYCoCg, historyBlend));
    if (any(isnan(outputColor)) || any(isinf(outputColor))) {
        outputColor = currentColor;
    }
    outputColor = clamp(outputColor, vec3(0.0), vec3(65504.0));

    imageStore(HistoryColorOut, pixel, vec4(outputColor, 1.0));
    imageStore(HistoryDepthOut, pixel, uvec4(packDepth(currentDepth), 0u, 0u, 0u));
}
