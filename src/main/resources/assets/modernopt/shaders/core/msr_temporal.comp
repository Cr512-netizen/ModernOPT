#version 450

// MSR 2.0 Compute Temporal Pass - Variance Clipping
// Runs on GL 4.3+ hardware. Falls back to fragment shader on older hardware.
// Reads entity motion vectors from SSBO for accurate per-entity reprojection.

#extension GL_ARB_shader_storage_buffer_object : enable
#extension GL_ARB_compute_shader : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D CurrentColor;   // Current frame low-res color
uniform sampler2D HistoryColor;   // Previous frame history color
uniform sampler2D HistoryDepth;   // Previous frame depth (R16_UINT)
uniform sampler2D CurrentDepth;   // Current frame depth

uniform vec2 InputSize;           // Low-res input size
uniform vec2 OutputSize;          // High-res output size
uniform vec2 Jitter;              // Current frame jitter
uniform float VarianceScale;      // Variance clipping threshold multiplier
uniform float DepthThreshold;     // Depth difference threshold
uniform float HistoryWeight;      // Base history blend weight
uniform vec3 CameraDelta;         // current camera pos - previous camera pos, world axes
uniform mat4 ViewRotation;        // current view rotation
uniform mat4 PrevViewRotation;    // previous view rotation
uniform mat4 InvProjection;       // inverse of unjittered current projection
uniform mat4 PrevProjection;      // unjittered previous projection
uniform float HistoryValid;       // 1.0 when history contains a valid frame
uniform float DepthValid;         // 1.0 when a correct scene depth is available

// SSBO: entity motion vectors (binding point 0)
struct EntityMotion {
    int entityId;
    float screenX;
    float screenY;
    float deltaX;
    float deltaY;
    float active;
};
layout(std430, binding = 0) readonly buffer EntityMotionBuffer {
    EntityMotion motions[];
};

// Output: write directly to history color/depth textures (image load/store)
layout(rgba32f, binding = 0) uniform image2D HistoryColorOut;
layout(r32ui, binding = 1) uniform image2D HistoryDepthOut;

// YCoCg conversion
vec3 rgbToYCoCg(vec3 rgb) {
    return vec3(
        rgb.r * 0.25 + rgb.g * 0.5 + rgb.b * 0.25,
        rgb.r * 0.5 - rgb.b * 0.5,
        rgb.g * 0.5 - rgb.r * 0.25 - rgb.b * 0.25
    );
}

vec3 yCoCgToRgb(vec3 ycocg) {
    float t = ycocg.x - ycocg.z;
    return vec3(t + ycocg.y, ycocg.x + ycocg.z, t - ycocg.y);
}

float unpackDepth(uint packed) {
    return float(packed) / 65535.0;
}

uint packDepth(float depth) {
    return uint(clamp(depth * 65535.0, 0.0, 65535.0));
}

// Find entity motion vector for a given screen position (nearest entity within radius)
vec2 findEntityMotion(vec2 screenUv) {
    vec2 motion = vec2(0.0);
    float bestDist = 0.1; // search radius in UV space
    for (int i = 0; i < motions.length() && i < 1024; i++) {
        if (motions[i].active < 0.5) continue;
        vec2 entityPos = vec2(motions[i].screenX, motions[i].screenY);
        float dist = distance(screenUv, entityPos);
        if (dist < bestDist) {
            bestDist = dist;
            motion = vec2(motions[i].deltaX, motions[i].deltaY);
        }
    }
    return motion;
}

// 3x3 neighbourhood variance in YCoCg space
void computeVariance(vec2 uv, vec2 texel,
                     out vec3 meanYCoCg, out vec3 varianceYCoCg) {
    meanYCoCg = vec3(0.0);
    vec3 meanSq = vec3(0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 sampleUv = clamp(uv + vec2(float(x), float(y)) * texel, vec2(0.0), vec2(1.0));
            vec3 color = texture(HistoryColor, sampleUv).rgb;
            vec3 ycocg = rgbToYCoCg(color);
            meanYCoCg += ycocg;
            meanSq += ycocg * ycocg;
        }
    }

    meanYCoCg /= 9.0;
    meanSq /= 9.0;
    varianceYCoCg = max(vec3(0.0), meanSq - meanYCoCg * meanYCoCg);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(InputSize);

    // Skip if out of bounds
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(InputSize);
    vec2 currentUv = uv + Jitter * 0.5;
    currentUv = clamp(currentUv, vec2(0.0), vec2(1.0));

    vec3 currentColor = texture(CurrentColor, currentUv).rgb;
    uint currentDepthPacked = uint(texture(CurrentDepth, currentUv).r * 65535.0);
    float currentDepth = unpackDepth(currentDepthPacked);

    // --- Reproject current pixel to previous frame ---
    bool valid = HistoryValid > 0.5;
    bool depthValid = DepthValid > 0.5;
    vec2 historyUv = uv;
    float historyDepth = 0.0;
    vec3 historyColor = vec3(0.0);

    if (valid && depthValid) {
        vec2 ndc = currentUv * 2.0 - 1.0;
        vec4 clip = vec4(ndc, currentDepth * 2.0 - 1.0, 1.0);
        vec4 viewPosition = InvProjection * clip;

        if (abs(viewPosition.w) > 1.0e-6) {
            viewPosition /= viewPosition.w;
            vec3 worldRelative = (vec4(viewPosition.xyz, 0.0) * ViewRotation).xyz;
            bool isSky = currentDepth > 0.9999995;
            vec3 previousRelative = worldRelative + (isSky ? vec3(0.0) : CameraDelta);

            // Check for entity motion vector override
            vec2 entityMotion = findEntityMotion(currentUv);
            if (length(entityMotion) > 0.001) {
                previousRelative += vec3(entityMotion.x, 0.0, entityMotion.y) * 0.1;
            }

            vec3 previousView = (PrevViewRotation * vec4(previousRelative, 1.0)).xyz;
            vec4 previousClip = PrevProjection * vec4(previousView, 1.0);

            if (previousClip.w > 1.0e-6) {
                vec2 previousNdc = previousClip.xy / previousClip.w;
                historyUv = previousNdc * 0.5 + 0.5;
                valid = valid && all(greaterThanEqual(historyUv, vec2(0.0)))
                                && all(lessThanEqual(historyUv, vec2(1.0)));
            } else {
                valid = false;
            }
        } else {
            valid = false;
        }
    } else {
        valid = false;
    }

    if (valid) {
        historyColor = texture(HistoryColor, historyUv).rgb;
        historyDepth = unpackDepth(uint(texture(HistoryDepth, historyUv).r * 65535.0));

        float tolerance = max(DepthThreshold * currentDepth * currentDepth, 0.02);
        valid = abs(historyDepth - currentDepth) <= tolerance;
    }

    // Compute local variance in 3x3 neighbourhood
    vec2 texel = 1.0 / InputSize;
    vec3 meanYCoCg, varianceYCoCg;
    computeVariance(uv, texel, meanYCoCg, varianceYCoCg);

    vec3 currentYCoCg = rgbToYCoCg(currentColor);
    vec3 historyYCoCg = rgbToYCoCg(historyColor);

    // Variance clipping: reject history if outside confidence interval
    vec3 stdDev = sqrt(max(vec3(0.0), varianceYCoCg));
    vec3 lowerBound = meanYCoCg - VarianceScale * stdDev;
    vec3 upperBound = meanYCoCg + VarianceScale * stdDev;

    bool withinVariance = all(greaterThanEqual(historyYCoCg, lowerBound)) &&
                          all(lessThanEqual(historyYCoCg, upperBound));

    float maxVariance = max(max(varianceYCoCg.x, varianceYCoCg.y), varianceYCoCg.z);
    bool isStatic = maxVariance < 0.001;

    float historyBlend = HistoryWeight;
    if (!valid || !withinVariance) {
        historyBlend = 0.0;
    } else if (isStatic) {
        historyBlend = min(HistoryWeight * 1.5, 0.95);
    }

    vec3 blendedYCoCg = mix(currentYCoCg, historyYCoCg, historyBlend);
    vec3 outputColor = yCoCgToRgb(blendedYCoCg);

    imageStore(HistoryColorOut, pixel, vec4(outputColor, currentDepth));
    imageStore(HistoryDepthOut, pixel, uvec4(currentDepthPacked, 0, 0, 0));
}